<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <LangVersion>latest</LangVersion>
    <Authors>Matthew Koch, MSKCC</Authors>
    <Company>Memorial Sloan Kettering Cancer Center</Company>
    <PackageTags>medidata;rws;clinical;edc;api;httpclient;dotnet8;dotnet9</PackageTags>
    <PackOnBuild>true</PackOnBuild>
    <NeutralLanguage>en</NeutralLanguage>
    <PackageLicenseUrl>https://github.com/mskcc/Medidata.RWS.NET.Standard/blob/master/LICENSE.md</PackageLicenseUrl>
    <PackageProjectUrl>https://github.com/mskcc/Medidata.RWS.NET.Standard/</PackageProjectUrl>
    <Summary>Modern .NET 8.0/9.0 API library for Medidata RAVE Web Services (RWS) with enhanced null safety and async patterns.</Summary>
    <Title>Medidata RWS .NET Client</Title>
    <Description>Comprehensive .NET 8.0/9.0 API library for Medidata RAVE Web Services (RWS). Features modern async patterns, nullable reference types, Flurl.Http 4.x, and enhanced performance for clinical data applications.</Description>
    <PackageId>Medidata.RWS.NET.Standard</PackageId>
    <Version>2.0.1</Version>
    <PackageVersion>2.0.1</PackageVersion>
    <Owners>Matthew Koch, MSKCC</Owners>
    <Copyright>Copyright 2018-2025 Matthew Koch and Memorial Sloan Kettering Cancer Center</Copyright>
    <ReleaseVersion>2.0.0</ReleaseVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Flurl.Http" Version="4.0.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="ODM\1.3.1\xsd\" />
    <Folder Include="Exceptions\" />
    <Folder Include="Core\Requests\Datasets\" />
    <Folder Include="Core\Requests\ODM Adapter\" />
    <Folder Include="Core\Requests\Biostat Adapter\" />
    <Folder Include="Builders\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="ODM\1.3.1\ODM %28copy%29.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
